{
  target {
    test {
      main "time/_demo.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
  },
  foreign {
    input [
      "source/foreign.c",
    ],
    output [
      "foreign.o",
    ],
    script [
      "{{clang}} -c -flto=thin -O2 source/foreign.c -o {{foreign}}/foreign.o",
    ],
  },
  dependency {
    core {
      digest "AX53Hz1GVFQcEX-csE0C33px9odb_zm98r5nRFnMvRg",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0-55-1.tar.zst",
      ],
      enable-preset true,
    },
  },
}
